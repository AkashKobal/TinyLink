<%- include("layout", { title: "Add Link" , body: ` <div class="bg-white p-6 rounded shadow w-full max-w-md mx-auto">
    <h1 class="text-xl font-bold mb-4">Create New Link</h1>

    ${error ? `
    <div class="bg-red-100 text-red-700 p-3 rounded mb-4 border border-red-300">
        ${error}
    </div>
    ` : ""}

    <form method="POST" action="/new" class="space-y-4">

        <div>
            <label class="block mb-1 font-medium">Target URL</label>
            <input name="target_url" class="w-full border rounded p-2" required placeholder="https://example.com">
        </div>

        <div>
            <label class="block mb-1 font-medium">Custom Code (optional)</label>
            <input name="code" class="w-full border rounded p-2" placeholder="6-8 characters">
            <p class="text-xs text-gray-500 mt-1">Must be 6–8 letters or numbers.</p>
        </div>

        <button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            Create
        </button>
    </form>
    </div>
    ` }) %>