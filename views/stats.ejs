<%- include("layout", { title: "Stats" , body: ` <div class="bg-white p-6 rounded shadow">

    ${error ? `
    <div class="bg-red-100 text-red-700 p-3 border border-red-300 rounded">
        ${error}
    </div>
    ` : `

    <h1 class="text-2xl font-bold mb-3">Stats for ${link.code}</h1>

    <p class="mb-2">
        <strong>Short URL:</strong>
        <span id="shortUrl" class="text-blue-700">
            ${shortUrl}
        </span>
    </p>

    <button onclick="copyShortUrl()"
        class="bg-gray-800 text-white px-3 py-1 rounded hover:bg-gray-900 mb-4 inline-block">
        Copy Short URL
    </button>

    <p class="mb-2"><strong>Target:</strong>
        <span class="text-blue-700">${link.target_url}</span>
    </p>

    <p class="mb-2"><strong>Total Clicks:</strong> ${link.click_count}</p>
    <p class="mb-4"><strong>Last Clicked:</strong> ${link.last_clicked || "Never"}</p>

    <a href="/${link.code}" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 inline-block">
        Visit Short URL
    </a>

    `}
    </div>

    <script>
        function copyShortUrl() {
            const text = document.getElementById("shortUrl").innerText;
            navigator.clipboard.writeText(text)
                .then(() => alert("Short URL copied: " + text))
                .catch(() => alert("Failed to copy URL"));
        }
    </script>

    ` }) %>